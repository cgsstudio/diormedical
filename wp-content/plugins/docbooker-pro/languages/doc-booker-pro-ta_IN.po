msgstr "கட்டணம் அகற்றப்பட்டது"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Advance"
msgstr "முன்பணம்"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Overpaid"
msgstr "அதிகமாகச் செலுத்தப்பட்டது"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Remove this payment?"
msgstr "இந்தக் கட்டணத்தை அகற்றவா?"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Use this only for a payment entered by mistake."
msgstr "தவறாக உள்ளிடப்பட்ட கட்டணத்திற்கு மட்டும் இதைப் பயன்படுத்தவும்."

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Remove payment"
msgstr "கட்டணத்தை அகற்று"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Enter an amount"
msgstr "தொகையை உள்ளிடவும்"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "More than the balance due"
msgstr "நிலுவைத் தொகையை விட அதிகம்"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Credit"
msgstr "வரவு"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Payment recorded"
msgstr "கட்டணம் பதிவு செய்யப்பட்டது"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Lab reports for this clinic are uploaded by its clinic manager from the Clinic Dashboard."
msgstr "இந்தக் கிளினிக்கின் ஆய்வக அறிக்கைகளை அதன் கிளினிக் மேலாளர் கிளினிக் டாஷ்போர்டிலிருந்து பதிவேற்றுகிறார்."

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Lab reports are uploaded by the clinic manager, but this clinic has none yet. Until one is added in Staff, only a site admin can upload reports."
msgstr "ஆய்வக அறிக்கைகளை கிளினிக் மேலாளர் பதிவேற்றுகிறார், ஆனால் இந்தக் கிளினிக்கிற்கு இன்னும் மேலாளர் இல்லை. பணியாளர்களில் ஒருவர் சேர்க்கப்படும் வரை, தள நிர்வாகி மட்டுமே அறிக்கைகளைப் பதிவேற்ற முடியும்."

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Take payment"
msgstr "கட்டணம் பெறு"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Record payment"
msgstr "கட்டணத்தைப் பதிவு செய்"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Amount received now"
msgstr "இப்போது பெற்ற தொகை"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "If the details match an order, a code is on its way to the email address on that order."
msgstr "விவரங்கள் ஒரு ஆர்டருடன் பொருந்தினால், அந்த ஆர்டரின் மின்னஞ்சல் முகவரிக்கு ஒரு குறியீடு அனுப்பப்படுகிறது."

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "If the details match an order, we emailed a 6-digit code to the address on that order."
msgstr "விவரங்கள் ஒரு ஆர்டருடன் பொருந்தினால், அந்த ஆர்டரின் முகவரிக்கு 6 இலக்கக் குறியீட்டை மின்னஞ்சல் செய்துள்ளோம்."

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "If the details match an order, we sent a 6-digit code by text to"
msgstr "விவரங்கள் ஒரு ஆர்டருடன் பொருந்தினால், 6 இலக்கக் குறியீட்டை SMS மூலம் அனுப்பியுள்ளோம்:"

#: src/js/public/components/receptionist-dashboard/views/VisitDetail.jsx
msgid "Too many wrong codes. Please request a new code."
msgstr "பல தவறான குறியீடுகள். புதிய குறியீட்டைக் கோரவும்."

#: blocks-src/src/blocks/booking-form/view.js
msgid "Review"
msgstr "மதிப்பாய்வு"

#: blocks-src/src/blocks/booking-form/view.js
msgid "Private and secure"
msgstr "தனிப்பட்டது, பாதுகாப்பானது"

#: blocks-src/src/blocks/advanced-heading/block.json
msgctxt "block title"
msgid "Advanced Heading"
msgstr "Título avanzado"

#: blocks-src/src/blocks/advanced-heading/block.json
msgctxt "block description"
msgid "An editorial section heading with 8 layout variants — eyebrow, title with accent, lede, and optional button."
msgstr "Un título de sección editorial con 8 variantes de diseño — antetítulo, título con acento, entradilla y botón opcional."

#: blocks-src/src/blocks/booking-form/block.json
msgctxt "block title"
msgid "Booking Form"
msgstr "Formulario de reservación"

#: blocks-src/src/blocks/booking-form/block.json
msgctxt "block description"
msgid "A full appointment-booking wizard in 2 layouts (split-screen wizard / compact inline). Uses the REAL DocBooker booking flow + the active payment gateway (Stripe or Razorpay) unchanged — no duplicated booking logic."
msgstr "Un asistente completo de reservación de citas en 2 diseños (asistente en pantalla dividida / compacto en línea). Usa el proceso de reservación REAL de DocBooker + la pasarela de pago activa (Stripe o Razorpay) sin cambios — sin lógica de reservación duplicada."

#: blocks-src/src/blocks/call-to-action/block.json
msgctxt "block title"
msgid "Call to Action"
msgstr "Llamada a la acción"

#: blocks-src/src/blocks/call-to-action/block.json
msgctxt "block description"
msgid "An editorial call-to-action with 6 layouts — centered photo hero, split, compact strip, gradient closer, pull-quote, and a 3-path card."
msgstr "Una llamada a la acción editorial con 6 diseños — portada con foto centrada, dividida, franja compacta, cierre degradado, cita destacada y tarjeta de 3 opciones."

#: blocks-src/src/blocks/clinics/block.json
msgctxt "block title"
msgid "Clinics"
msgstr "Clínicas"

#: blocks-src/src/blocks/clinics/block.json
msgctxt "block description"
msgid "A clinic/location directory in 5 layouts (card / feature / gallery / map / compact), reading real clinic profiles — type, hours, services, contact, specialists, and a list↔pin map."
msgstr "Un directorio de clínicas/ubicaciones en 5 diseños (tarjeta / destacado / galería / mapa / compacto), que lee los perfiles reales de las clínicas — tipo, horario, servicios, contacto, especialistas y un mapa lista↔marcador."

#: blocks-src/src/blocks/countdown/block.json
msgctxt "block title"
msgid "Countdown"
msgstr "Cuenta regresiva"

#: blocks-src/src/blocks/countdown/block.json
msgctxt "block description"
msgid "A live-ticking countdown to a date with 6 skins (banner: gradient / cream / sticky · boxed: paper / tiles / rings) and an expired state."
msgstr "Una cuenta regresiva en vivo hacia una fecha con 6 estilos (banner: degradado / crema / fijo · en caja: papel / mosaicos / anillos) y un estado al terminar."

#: blocks-src/src/blocks/departments/block.json
msgctxt "block title"
msgid "Departments"
msgstr "Especialidades"

#: blocks-src/src/blocks/departments/block.json
msgctxt "block description"
msgid "A department directory in 3 layouts (grid / pill-cloud / icon-cards), reading the doctor-department taxonomy with each term's icon + accent color and live specialist counts."
msgstr "Un directorio de especialidades en 3 diseños (cuadrícula / nube de píldoras / tarjetas con icono), que lee la taxonomía de especialidades con el icono y color de acento de cada una y el número real de especialistas."

#: blocks-src/src/blocks/doctor-awards/block.json
msgctxt "block title"
msgid "Doctor Awards"
msgstr "Premios del médico"

#: blocks-src/src/blocks/doctor-awards/block.json
msgctxt "block description"
msgid "Showcase doctors' awards & honors in 2 layouts — a bronze trophy-wall (practice-wide masonry) or a per-doctor credential list. Reads each doctor's real awards meta."
msgstr "Muestra los premios y reconocimientos de los médicos en 2 diseños — un muro de trofeos en bronce (mosaico de todo el consultorio) o una lista de credenciales por médico. Lee los premios reales de cada médico."

#: blocks-src/src/blocks/doctor-fee-badge/block.json
msgctxt "block title"
msgid "Doctor Fee Badge"
msgstr "Insignia de tarifa del médico"

#: blocks-src/src/blocks/doctor-fee-badge/block.json
msgctxt "block description"
msgid "A small fee badge in 3 variants (pill / starburst / flat) × 3 sizes, showing a doctor's real booking fee — drop it into a card, sidebar, sentence or list."
msgstr "Una pequeña insignia de tarifa en 3 variantes (píldora / destello / plana) × 3 tamaños, que muestra la tarifa real de reservación de un médico — colócala en una tarjeta, barra lateral, frase o lista."

#: blocks-src/src/blocks/doctor-schedule/block.json
msgctxt "block title"
msgid "Doctor Schedule"
msgstr "Horario del médico"

#: blocks-src/src/blocks/doctor-schedule/block.json
msgctxt "block description"
msgid "A single doctor's weekly timetable in 5 layouts (week-grid / day-pills / spotlight / timeline / compact-list). Reads the real wpddb_doctor_schedule meta; every offered slot deep-links into the live booking flow (Stripe / Razorpay / fallback). Supports a ?doctor= URL override."
msgstr "El horario semanal de un médico en 5 diseños (cuadrícula semanal / píldoras de días / destacado / línea de tiempo / lista compacta). Lee el metadato real wpddb_doctor_schedule; cada horario ofrecido enlaza directo al proceso de reservación real (Stripe / Razorpay / alternativa). Admite cambiar con ?doctor= en la URL."

#: blocks-src/src/blocks/doctor-stats/block.json
msgctxt "block title"
msgid "Doctor Stats"
msgstr "Cifras del médico"

#: blocks-src/src/blocks/doctor-stats/block.json
msgctxt "block description"
msgid "Practice statistics in 2 layouts — an accent-tinted card grid or a compact strip (cream / dark / inline). Author-entered numbers with an animated count-up."
msgstr "Cifras del consultorio en 2 diseños — cuadrícula de tarjetas con acento o franja compacta (crema / oscura / en línea). Números que tú ingresas, con conteo animado."

#: blocks-src/src/blocks/doctors/block.json
msgctxt "block title"
msgid "Doctors"
msgstr "Médicos"

#: blocks-src/src/blocks/doctors/block.json
msgctxt "block description"
msgid "A data-driven doctors directory with 5 layouts (card / hover-reveal / feature / mini / list), reading real doctor profiles — with an optional Clinic + Department AJAX filter and load-more pagination."
msgstr "Un directorio de médicos con datos reales en 5 diseños (tarjeta / mostrar al pasar el cursor / destacado / mini / lista), que lee los perfiles reales de los médicos — con filtro AJAX opcional por clínica y especialidad y paginación con Cargar más."

#: blocks-src/src/blocks/faq/block.json
msgctxt "block title"
msgid "FAQ"
msgstr "Preguntas frecuentes"

#: blocks-src/src/blocks/faq/block.json
msgctxt "block description"
msgid "An expand/collapse FAQ with 6 layouts — accordion (hairline / carded / split) and categorized (category nav / tabs / masonry cards). Single or multi-open, accessible, grounded in real DocBooker features."
msgstr "Preguntas frecuentes desplegables con 6 diseños — acordeón (líneas finas / en tarjetas / dividido) y por categorías (navegación por categoría / pestañas / tarjetas en mosaico). Una o varias abiertas, accesible y basado en funciones reales de DocBooker."

#: blocks-src/src/blocks/hero/block.json
msgctxt "block title"
msgid "Hero"
msgstr "Portada"

#: blocks-src/src/blocks/hero/block.json
msgctxt "block description"
msgid "A flexible page hero with 5 layouts — image-forward (floating stat/rating/credential cards + trust strip), mirror, centered overlay, split-action (booking entry card), and minimal editorial."
msgstr "Una portada de página flexible con 5 diseños — imagen al frente (tarjetas flotantes de dato/calificación/credencial + franja de confianza), espejo, superpuesto centrado, acción dividida (tarjeta de inicio de reservación) y editorial mínimo."

#: blocks-src/src/blocks/info-box/block.json
msgctxt "block title"
msgid "Info Box"
msgstr "Cuadro de información"

#: blocks-src/src/blocks/info-box/block.json
msgctxt "block description"
msgid "An editorial info box with 9 skins across 3 families — icon-stack, side-by-side, and image-led."
msgstr "Un cuadro de información editorial con 9 estilos en 3 familias — icono apilado, lado a lado y con imagen."

#: blocks-src/src/blocks/office-hours/block.json
msgctxt "block title"
msgid "Office Hours"
msgstr "Horario de atención"

#: blocks-src/src/blocks/office-hours/block.json
msgctxt "block description"
msgid "Author-driven weekly opening hours with a live Open-now / Closed status and 6 layouts — table (ruled week / compact list / day-chip strip) and card (split / status band / stacked)."
msgstr "Horario semanal de atención que tú defines, con estado en vivo Abierto ahora / Cerrado y 6 diseños — tabla (semana con líneas / lista compacta / franja de días) y tarjeta (dividida / franja de estado / apilada)."

#: blocks-src/src/blocks/process-steps/block.json
msgctxt "block title"
msgid "Process Steps"
msgstr "Pasos del proceso"

#: blocks-src/src/blocks/process-steps/block.json
msgctxt "block description"
msgid "A how-it-works / patient-journey stepper with 9 layouts — vertical (left-rail / zig-zag / stacked), timeline (node-line / icon-disc / segmented progress), and cards (big-numeral / filled / icon-row)."
msgstr "Un paso a paso de cómo funciona / recorrido del paciente con 9 diseños — vertical (riel izquierdo / zigzag / apilado), línea de tiempo (nodos en línea / disco con icono / progreso segmentado) y tarjetas (número grande / relleno / fila de iconos)."

#: blocks-src/src/blocks/quick-book/block.json
msgctxt "block title"
msgid "Quick Book"
msgstr "Reservación rápida"

#: blocks-src/src/blocks/quick-book/block.json
msgctxt "block description"
msgid "A compact single-doctor \"Book Now\" widget in 3 variants (sidebar / sticky / hero). Reads a real doctor's profile + fee and routes to the live booking flow (Stripe / Razorpay / fallback). Supports a ?doctor= URL override."
msgstr "Un widget compacto \"Reservar ahora\" para un médico en 3 variantes (barra lateral / fija / portada). Lee el perfil y la tarifa reales de un médico y lleva al proceso de reservación real (Stripe / Razorpay / alternativa). Admite cambiar con ?doctor= en la URL."

#: blocks-src/src/blocks/services/block.json
msgctxt "block title"
msgid "Services"
msgstr "Servicios"

#: blocks-src/src/blocks/services/block.json
msgctxt "block description"
msgid "An author-managed services block with 4 layouts — card grid (3 styles), alternating media rows, numbered list, and a two-column 'what we treat' grid."
msgstr "Un bloque de servicios que tú gestionas, con 4 diseños — cuadrícula de tarjetas (3 estilos), filas multimedia alternadas, lista numerada y una cuadrícula de dos columnas 'lo que tratamos'."

#: blocks-src/src/blocks/slider/block.json
msgctxt "block title"
msgid "Slider"
msgstr "Carrusel"

#: blocks-src/src/blocks/slider/block.json
msgctxt "block description"
msgid "A Swiper-powered editorial carousel with 3 layouts — full-bleed hero, peek-next cards, and a fixed-left split — fully configurable transitions, navigation, autoplay and pagination."
msgstr "Un carrusel editorial con Swiper en 3 diseños — portada a todo lo ancho, tarjetas con vista de la siguiente y dividido con lado izquierdo fijo — con transiciones, navegación, reproducción automática y paginación configurables."

#: blocks-src/src/blocks/testimonials/block.json
msgctxt "block title"
msgid "Testimonials"
msgstr "Testimonios"

#: blocks-src/src/blocks/testimonials/block.json
msgctxt "block description"
msgid "Patient testimonials in 3 layouts — quote-cards grid, featured spotlight (hero + thumbnail rail), or a masonry wall. Author-entered quotes with rating, verified badge and an optional doctor link."
msgstr "Testimonios de pacientes en 3 diseños — cuadrícula de tarjetas de cita, destacado principal (portada + fila de miniaturas) o muro en mosaico. Citas que tú ingresas, con calificación, insignia de verificado y enlace opcional al médico."

#: blocks-src/src/blocks/wrapper/block.json
msgctxt "block title"
msgid "Wrapper"
msgstr "Contenedor"

#: blocks-src/src/blocks/wrapper/block.json
msgctxt "block description"
msgid "A flexible section wrapper — full-bleed background, padding, and a centered content-width cap. Nest any blocks inside."
msgstr "Un contenedor de sección flexible — fondo a todo lo ancho, relleno y ancho de contenido centrado. Coloca cualquier bloque dentro."


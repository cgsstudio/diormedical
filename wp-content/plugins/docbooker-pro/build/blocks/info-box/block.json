    "displayIcon": {
      "type": "boolean",
      "default": true
    },
    "iconName": {
      "type": "string",
      "default": "heart"
    },
    "iconColor": {
      "type": "string",
      "default": ""
    },
    "iconSize": {
      "type": "object",
      "default": {
        "lg": "",
        "unit": "px"
      }
    },
    "image": {
      "type": "object",
      "default": {
        "url": "",
        "id": 0
      }
    },
    "displayEyebrow": {
      "type": "boolean",
      "default": true

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doc-booker-pro/info-box",
  "title": "Info Box",
  "category": "doc-booker-blocks",
  "icon": "info",
  "description": "An editorial info box with 9 skins across 3 families — icon-stack, side-by-side, and image-led.",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]

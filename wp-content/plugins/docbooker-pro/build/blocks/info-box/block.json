    "linkText": {
      "type": "string",
      "default": ""
    },
    "linkURL": {
      "type": "string",
      "default": ""
    },
    "linkNewTab": {
      "type": "boolean",
      "default": false
    },
    "linkNoFollow": {
      "type": "boolean",
      "default": false

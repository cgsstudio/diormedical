{"translation-revision-date":"YEAR-MO-DA HO:MI+ZONE","generator":"WP-CLI\/2.10.0","source":"src\/js\/admin\/app\/settings\/sections.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hi_IN","plural-forms":"nplurals=2; plural=(n != 1);"},"Online Payments":["\u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928"],"Clinics":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915"],"Description":["\u0935\u093f\u0935\u0930\u0923"],"Department":["\u0935\u093f\u092d\u093e\u0917"],"Speciality":["\u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u0924\u093e"],"Doctors":["\u0921\u0949\u0915\u094d\u091f\u0930"],"As added":["\u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u0947 \u0915\u094d\u0930\u092e \u092e\u0947\u0902"],"Name, A to Z":["\u0928\u093e\u092e, A \u0938\u0947 Z"],"Date added":["\u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916"],"Post ID":["\u092a\u094b\u0938\u094d\u091f ID"],"Address name":["\u092a\u0924\u0947 \u0915\u093e \u0928\u093e\u092e"],"Page order":["\u092a\u0947\u091c \u0915\u093e \u0915\u094d\u0930\u092e"],"Random":["\u0930\u0948\u0902\u0921\u092e"],"Ascending":["\u092c\u0922\u093c\u0924\u0947 \u0915\u094d\u0930\u092e \u092e\u0947\u0902"],"Descending":["\u0918\u091f\u0924\u0947 \u0915\u094d\u0930\u092e \u092e\u0947\u0902"],"Text":["\u091f\u0947\u0915\u094d\u0938\u094d\u091f"],"Full width":["\u092a\u0942\u0930\u0940 \u091a\u094c\u0921\u093c\u093e\u0908"],"Sidebar on the left":["\u092c\u093e\u0908\u0902 \u0913\u0930 \u0938\u093e\u0907\u0921\u092c\u093e\u0930"],"Sidebar on the right":["\u0926\u093e\u0908\u0902 \u0913\u0930 \u0938\u093e\u0907\u0921\u092c\u093e\u0930"],"%d column":["%d \u0915\u0949\u0932\u092e","%d \u0915\u0949\u0932\u092e"],"%d line":["%d \u0932\u093e\u0907\u0928","%d \u0932\u093e\u0907\u0928\u0947\u0902"],"General":["\u0938\u093e\u092e\u093e\u0928\u094d\u092f"],"Currency and the booking form.":["\u092e\u0941\u0926\u094d\u0930\u093e \u0914\u0930 \u092c\u0941\u0915\u093f\u0902\u0917 \u092b\u093c\u0949\u0930\u094d\u092e\u0964"],"Money":["\u0915\u0940\u092e\u0924"],"How fees are written on the site.":["\u0938\u093e\u0907\u091f \u092a\u0930 \u092b\u093c\u0940\u0938 \u0915\u0948\u0938\u0947 \u0932\u093f\u0916\u0940 \u091c\u093e\u090f\u0964"],"Currency":["\u092e\u0941\u0926\u094d\u0930\u093e"],"Used for each doctor's fee.":["\u0939\u0930 \u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0940 \u092b\u093c\u0940\u0938 \u0915\u0947 \u0932\u093f\u090f\u0964"],"Without online payment, patients see the fee and pay at the clinic.":["\u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u092c\u093f\u0928\u093e \u092e\u0930\u0940\u091c\u093c \u092b\u093c\u0940\u0938 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092a\u0930 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"],"The full booking form: department, doctor, time, then the patient's details.":["\u092a\u0942\u0930\u093e \u092c\u0941\u0915\u093f\u0902\u0917 \u092b\u093c\u0949\u0930\u094d\u092e: \u0935\u093f\u092d\u093e\u0917, \u0921\u0949\u0915\u094d\u091f\u0930, \u0938\u092e\u092f, \u092b\u093f\u0930 \u092e\u0930\u0940\u091c\u093c \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\u0964"],"Open the page in the editor, add a Shortcode block and paste it in.":["\u092a\u0947\u091c \u0915\u094b \u090f\u0921\u093f\u091f\u0930 \u092e\u0947\u0902 \u0916\u094b\u0932\u0947\u0902, Shortcode \u092c\u094d\u0932\u0949\u0915 \u091c\u094b\u0921\u093c\u0947\u0902 \u0914\u0930 \u0907\u0938\u0947 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964"],"Pages":["\u092a\u0947\u091c"],"Which pages show your lists and dashboards.":["\u0915\u094c\u0928-\u0938\u0947 \u092a\u0947\u091c \u0906\u092a\u0915\u0940 \u0938\u0942\u091a\u093f\u092f\u093e\u0901 \u0914\u0930 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0926\u093f\u0916\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"],"Lists":["\u0938\u0942\u091a\u093f\u092f\u093e\u0901"],"Which page shows each list. Pick from pages you already have.":["\u0915\u094c\u0928-\u0938\u093e \u092a\u0947\u091c \u0915\u094c\u0928-\u0938\u0940 \u0938\u0942\u091a\u0940 \u0926\u093f\u0916\u093e\u090f\u0964 \u0905\u092a\u0928\u0947 \u092e\u094c\u091c\u0942\u0926\u093e \u092a\u0947\u091c\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u091a\u0941\u0928\u0947\u0902\u0964"],"The page that lists all doctors.":["\u0935\u0939 \u092a\u0947\u091c \u091c\u0939\u093e\u0901 \u0938\u092d\u0940 \u0921\u0949\u0915\u094d\u091f\u0930 \u0926\u093f\u0916\u0924\u0947 \u0939\u0948\u0902\u0964"],"The page that lists all clinics.":["\u0935\u0939 \u092a\u0947\u091c \u091c\u0939\u093e\u0901 \u0938\u092d\u0940 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0926\u093f\u0916\u0924\u0947 \u0939\u0948\u0902\u0964"],"Front-end pages for clinic staff, and for patients to see their lab reports.":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0938\u094d\u091f\u093e\u092b\u093c \u0915\u0947 \u0932\u093f\u090f \u0914\u0930 \u092e\u0930\u0940\u091c\u093c\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0932\u0948\u092c \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u092a\u0947\u091c\u0964"],"Clinic managers go here after they log in.":["\u0932\u0949\u0917 \u0907\u0928 \u0915\u0947 \u092c\u093e\u0926 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092e\u0948\u0928\u0947\u091c\u0930 \u092f\u0939\u093e\u0901 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964"],"Used once clinic manager accounts are on (Settings \u2192 Clinic Staff).":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092e\u0948\u0928\u0947\u091c\u0930 \u0905\u0915\u093e\u0909\u0902\u091f \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u094b\u0924\u093e \u0939\u0948 (\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u2192 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0938\u094d\u091f\u093e\u092b\u093c)\u0964"],"Receptionists go here after they log in.":["\u0932\u0949\u0917 \u0907\u0928 \u0915\u0947 \u092c\u093e\u0926 \u0930\u093f\u0938\u0947\u092a\u094d\u0936\u0928\u093f\u0938\u094d\u091f \u092f\u0939\u093e\u0901 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964"],"Used once receptionist accounts are on (Settings \u2192 Clinic Staff).":["\u0930\u093f\u0938\u0947\u092a\u094d\u0936\u0928\u093f\u0938\u094d\u091f \u0905\u0915\u093e\u0909\u0902\u091f \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u094b\u0924\u093e \u0939\u0948 (\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u2192 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0938\u094d\u091f\u093e\u092b\u093c)\u0964"],"Patients enter their mobile number and invoice code here to see their reports.":["\u0905\u092a\u0928\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0930\u0940\u091c\u093c \u092f\u0939\u093e\u0901 \u0905\u092a\u0928\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0914\u0930 \u0907\u0928\u0935\u0949\u0907\u0938 \u0915\u094b\u0921 \u0921\u093e\u0932\u0924\u0947 \u0939\u0948\u0902\u0964"],"Web Addresses":["\u0935\u0947\u092c \u092a\u0924\u0947"],"The links to doctor, department and clinic pages.":["\u0921\u0949\u0915\u094d\u091f\u0930, \u0935\u093f\u092d\u093e\u0917 \u0914\u0930 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092a\u0947\u091c\u094b\u0902 \u0915\u0947 \u0932\u093f\u0902\u0915\u0964"],"The word in the link before each doctor, department or clinic name.":["\u0932\u093f\u0902\u0915 \u092e\u0947\u0902 \u0939\u0930 \u0921\u0949\u0915\u094d\u091f\u0930, \u0935\u093f\u092d\u093e\u0917 \u092f\u093e \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u0947 \u0928\u093e\u092e \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u0928\u0947 \u0935\u093e\u0932\u093e \u0936\u092c\u094d\u0926\u0964"],"Changing a word breaks links people have saved or shared. Change it before the site goes live.":["\u0936\u092c\u094d\u0926 \u092c\u0926\u0932\u0928\u0947 \u0938\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0938\u0947\u0935 \u092f\u093e \u0936\u0947\u092f\u0930 \u0915\u093f\u090f \u0932\u093f\u0902\u0915 \u091f\u0942\u091f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u093e\u0907\u091f \u0932\u093e\u0907\u0935 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u0926\u0932\u0947\u0902\u0964"],"How doctors are listed and what their pages show.":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0948\u0938\u0947 \u0926\u093f\u0916\u093e\u090f \u091c\u093e\u090f\u0901 \u0914\u0930 \u0909\u0928\u0915\u0947 \u092a\u0947\u091c \u092a\u0930 \u0915\u094d\u092f\u093e \u0926\u093f\u0916\u0947\u0964"],"How the page with all doctors looks.":["\u0938\u092d\u0940 \u0921\u0949\u0915\u094d\u091f\u0930 \u0935\u093e\u0932\u093e \u092a\u0947\u091c \u0915\u0948\u0938\u093e \u0926\u093f\u0916\u0947\u0964"],"Turn parts of the card on or off.":["\u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0939\u093f\u0938\u094d\u0938\u0947 \u091a\u093e\u0932\u0942 \u092f\u093e \u092c\u0902\u0926 \u0915\u0930\u0947\u0902\u0964"],"The first lines of the doctor's bio.":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0947 \u092a\u0930\u093f\u091a\u092f \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0932\u093e\u0907\u0928\u0947\u0902\u0964"],"For example Cardiology.":["\u091c\u0948\u0938\u0947 \u0915\u093e\u0930\u094d\u0921\u093f\u092f\u094b\u0932\u0949\u091c\u0940\u0964"],"For example Senior Consultant.":["\u091c\u0948\u0938\u0947 \u0938\u0940\u0928\u093f\u092f\u0930 \u0915\u0902\u0938\u0932\u094d\u091f\u0947\u0902\u091f\u0964"],"What the doctor treats most.":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0915\u093f\u0938\u0915\u093e \u0907\u0932\u093e\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"],"Workplace":["\u0915\u093e\u0930\u094d\u092f\u0938\u094d\u0925\u0932"],"Hospital or practice name.":["\u0939\u0949\u0938\u094d\u092a\u093f\u091f\u0932 \u092f\u093e \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u093e \u0928\u093e\u092e\u0964"],"Degrees":["\u0921\u093f\u0917\u094d\u0930\u093f\u092f\u093e\u0901"],"For example MBBS, FCPS.":["\u091c\u0948\u0938\u0947 MBBS, FCPS\u0964"],"Icons for the doctor's profiles.":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0906\u0907\u0915\u0928\u0964"],"Photos":["\u092b\u093c\u094b\u091f\u094b"],"Size of the photo on each card.":["\u0939\u0930 \u0915\u093e\u0930\u094d\u0921 \u092a\u0930 \u092b\u093c\u094b\u091f\u094b \u0915\u093e \u0938\u093e\u0907\u091c\u093c\u0964"],"Width (px)":["\u091a\u094c\u0921\u093c\u093e\u0908 (px)"],"Height (px)":["\u090a\u0901\u091a\u093e\u0908 (px)"],"Off keeps the whole photo and may leave the cards different heights.":["\u092c\u0902\u0926 \u0930\u0916\u0928\u0947 \u092a\u0930 \u092a\u0942\u0930\u0940 \u092b\u093c\u094b\u091f\u094b \u0926\u093f\u0916\u0924\u0940 \u0939\u0948, \u092a\u0930 \u0915\u093e\u0930\u094d\u0921 \u0915\u0940 \u090a\u0901\u091a\u093e\u0908 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964"],"None \u2013 e.g. 12px or 0 15px 15px 15px":["\u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u2013 \u091c\u0948\u0938\u0947 12px \u092f\u093e 0 15px 15px 15px"],"One value for all corners, or four: top-left, top-right, bottom-right, bottom-left.":["\u0938\u092d\u0940 \u0915\u094b\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092e\u093e\u0928, \u092f\u093e \u091a\u093e\u0930: \u090a\u092a\u0930-\u092c\u093e\u090f\u0901, \u090a\u092a\u0930-\u0926\u093e\u090f\u0901, \u0928\u0940\u091a\u0947-\u0926\u093e\u090f\u0901, \u0928\u0940\u091a\u0947-\u092c\u093e\u090f\u0901\u0964"],"Leave these empty to list every doctor.":["\u0938\u092d\u0940 \u0921\u0949\u0915\u094d\u091f\u0930 \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0928\u094d\u0939\u0947\u0902 \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"],"Add a doctor\u2026":["\u0921\u0949\u0915\u094d\u091f\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u2026"],"Add a department\u2026":["\u0935\u093f\u092d\u093e\u0917 \u091c\u094b\u0921\u093c\u0947\u0902\u2026"],"Days, times and clinics on the doctor's page.":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0947 \u092a\u0947\u091c \u092a\u0930 \u0926\u093f\u0928, \u0938\u092e\u092f \u0914\u0930 \u0915\u094d\u0932\u093f\u0928\u093f\u0915\u0964"],"Adds \"Bookable\" next to times patients can book online.":["\u091c\u093f\u0928 \u0938\u092e\u092f \u0915\u094b \u092e\u0930\u0940\u091c\u093c \u0911\u0928\u0932\u093e\u0907\u0928 \u092c\u0941\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u0947 \u092a\u093e\u0938 \"\u092c\u0941\u0915 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\" \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"],"The clinic's phone number beside the schedule.":["\u0938\u092e\u092f-\u0938\u093e\u0930\u0923\u0940 \u0915\u0947 \u092a\u093e\u0938 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u093e \u092b\u093c\u094b\u0928 \u0928\u0902\u092c\u0930\u0964"],"How clinics are listed and what their pages show.":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u0948\u0938\u0947 \u0926\u093f\u0916\u093e\u090f \u091c\u093e\u090f\u0901 \u0914\u0930 \u0909\u0928\u0915\u0947 \u092a\u0947\u091c \u092a\u0930 \u0915\u094d\u092f\u093e \u0926\u093f\u0916\u0947\u0964"],"How the page with all clinics looks.":["\u0938\u092d\u0940 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0935\u093e\u0932\u093e \u092a\u0947\u091c \u0915\u0948\u0938\u093e \u0926\u093f\u0916\u0947\u0964"],"The first lines about the clinic.":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0932\u093e\u0907\u0928\u0947\u0902\u0964"],"Opens the clinic's location on a map.":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u0940 \u0932\u094b\u0915\u0947\u0936\u0928 \u092e\u0948\u092a \u092a\u0930 \u0916\u094b\u0932\u0924\u093e \u0939\u0948\u0964"],"View Location Map":["\u0932\u094b\u0915\u0947\u0936\u0928 \u092e\u0948\u092a \u0926\u0947\u0916\u0947\u0902"],"Clinic photos":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u0940 \u092b\u093c\u094b\u091f\u094b"],"Leave these empty to list every clinic.":["\u0938\u092d\u0940 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0928\u094d\u0939\u0947\u0902 \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"],"Add a clinic\u2026":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u091c\u094b\u0921\u093c\u0947\u0902\u2026"],"Slider":["\u0938\u094d\u0932\u093e\u0907\u0921\u0930"],"Grid":["\u0917\u094d\u0930\u093f\u0921"],"Booking Rules":["\u092c\u0941\u0915\u093f\u0902\u0917 \u0928\u093f\u092f\u092e"],"Booking limits, reminder emails and cancelling.":["\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u0940\u092e\u093e\u090f\u0901, \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0908\u092e\u0947\u0932 \u0914\u0930 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u093e\u0964"],"days ahead":["\u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0924\u0915"],"0 means no limit. The calendar only shows days up to this.":["0 \u0915\u093e \u092e\u0924\u0932\u092c \u0915\u094b\u0908 \u0938\u0940\u092e\u093e \u0928\u0939\u0940\u0902\u0964 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0938\u093f\u0930\u094d\u092b\u093c \u0907\u0924\u0928\u0947 \u0926\u093f\u0928 \u0906\u0917\u0947 \u0924\u0915 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964"],"hours":["\u0918\u0902\u091f\u0947"],"With 2, at 10:15 the earliest time a patient can pick is 12:15. 0 allows any time that has not passed.":["2 \u0930\u0916\u0928\u0947 \u092a\u0930, 10:15 \u092c\u091c\u0947 \u092e\u0930\u0940\u091c\u093c \u0938\u092c\u0938\u0947 \u091c\u0932\u094d\u0926\u0940 12:15 \u0915\u093e \u0938\u092e\u092f \u091a\u0941\u0928 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 0 \u0930\u0916\u0928\u0947 \u092a\u0930 \u0915\u094b\u0908 \u092d\u0940 \u0906\u0928\u0947 \u0935\u093e\u0932\u093e \u0938\u092e\u092f \u091a\u0941\u0928\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"],"Sent about a day before the appointment.":["\u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0938\u0947 \u0932\u0917\u092d\u0917 \u090f\u0915 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u092d\u0947\u091c\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"],"With the clinic address and a link to cancel. Not sent for bookings made less than a day ahead.":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u0947 \u092a\u0924\u0947 \u0914\u0930 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u0902\u0915 \u0915\u0947 \u0938\u093e\u0925\u0964 \u090f\u0915 \u0926\u093f\u0928 \u0938\u0947 \u0915\u092e \u092a\u0939\u0932\u0947 \u0915\u0940 \u0917\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u0930 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u093e \u091c\u093e\u0924\u093e\u0964"],"With the patient's name and phone, to the email on the doctor's profile.":["\u092e\u0930\u0940\u091c\u093c \u0915\u0947 \u0928\u093e\u092e \u0914\u0930 \u092b\u093c\u094b\u0928 \u0915\u0947 \u0938\u093e\u0925, \u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0935\u093e\u0932\u0947 \u0908\u092e\u0947\u0932 \u092a\u0930\u0964"],"Cancelling":["\u0930\u0926\u094d\u0926 \u0939\u094b \u0930\u0939\u093e \u0939\u0948"],"The time then opens up for other patients. Bookings paid online can only be cancelled by the clinic.":["\u092b\u093f\u0930 \u092f\u0939 \u0938\u092e\u092f \u0926\u0942\u0938\u0930\u0947 \u092e\u0930\u0940\u091c\u093c\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0916\u0941\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093e\u0932\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u093f\u0930\u094d\u092b\u093c \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0930\u0926\u094d\u0926 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964"],"hours before":["\u0918\u0902\u091f\u0947 \u092a\u0939\u0932\u0947"],"After this, the link tells the patient to call the clinic. 0 allows cancelling until the appointment starts.":["\u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0932\u093f\u0902\u0915 \u092e\u0930\u0940\u091c\u093c \u0915\u094b \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u094b \u0915\u0949\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u0924\u093e \u0939\u0948\u0964 0 \u0930\u0916\u0928\u0947 \u092a\u0930 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u0924\u0915 \u0930\u0926\u094d\u0926 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"],"Style":["\u0938\u094d\u091f\u093e\u0907\u0932"],"Colours and text on doctor and clinic cards.":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0914\u0930 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0930\u0902\u0917 \u0914\u0930 \u091f\u0947\u0915\u094d\u0938\u094d\u091f\u0964"],"Colours":["\u0930\u0902\u0917"],"Used across doctor and clinic pages, buttons and the booking form.":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0914\u0930 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092a\u0947\u091c\u094b\u0902, \u092c\u091f\u0928\u094b\u0902 \u0914\u0930 \u092c\u0941\u0915\u093f\u0902\u0917 \u092b\u093c\u0949\u0930\u094d\u092e \u092e\u0947\u0902 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"],"Buttons, links and highlights.":["\u092c\u091f\u0928, \u0932\u093f\u0902\u0915 \u0914\u0930 \u0939\u093e\u0907\u0932\u093e\u0907\u091f\u0964"],"Soft backgrounds and tags.":["\u0939\u0932\u094d\u0915\u0947 \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u0914\u0930 \u091f\u0948\u0917\u0964"],"Lines around cards and boxes.":["\u0915\u093e\u0930\u094d\u0921 \u0914\u0930 \u092c\u0949\u0915\u094d\u0938 \u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u0940 \u0932\u093e\u0907\u0928\u0947\u0902\u0964"],"Name":["\u0928\u093e\u092e"],"Payments":["\u092d\u0941\u0917\u0924\u093e\u0928"],"Take payment by card when patients book.":["\u092e\u0930\u0940\u091c\u093c\u094b\u0902 \u0915\u0947 \u092c\u0941\u0915 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0915\u093e\u0930\u094d\u0921 \u0938\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0932\u0947\u0902\u0964"],"Patients pay when they book.":["\u092e\u0930\u0940\u091c\u093c \u092c\u0941\u0915 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"],"Patients pay by card when they book.":["\u092e\u0930\u0940\u091c\u093c \u092c\u0941\u0915 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0915\u093e\u0930\u094d\u0921 \u0938\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"],"Mode":["\u092e\u094b\u0921"],"Patients choose: pay online now, or pay at the clinic on the day. When off, they must pay online.":["\u092e\u0930\u0940\u091c\u093c \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902: \u0905\u092d\u0940 \u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902, \u092f\u093e \u0909\u0938\u0940 \u0926\u093f\u0928 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092a\u0930\u0964 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964"],"SMS & OTP":["SMS \u0914\u0930 OTP"],"Text message login codes and booking confirmations.":["\u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092e\u0948\u0938\u0947\u091c \u0938\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u094b\u0921 \u0914\u0930 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0928\u094d\u092b\u093c\u0930\u094d\u092e\u0947\u0936\u0928\u0964"],"Sends login codes for the lab reports page and booking confirmations by text.":["\u0932\u0948\u092c \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092a\u0947\u091c \u0915\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u094b\u0921 \u0914\u0930 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0928\u094d\u092b\u093c\u0930\u094d\u092e\u0947\u0936\u0928 SMS \u0938\u0947 \u092d\u0947\u091c\u0924\u093e \u0939\u0948\u0964"],"On. Codes and confirmations go out through the service below.":["\u091a\u093e\u0932\u0942\u0964 \u0915\u094b\u0921 \u0914\u0930 \u0915\u0928\u094d\u092b\u093c\u0930\u094d\u092e\u0947\u0936\u0928 \u0928\u0940\u091a\u0947 \u0926\u0940 \u0917\u0908 \u0938\u0947\u0935\u093e \u0938\u0947 \u092d\u0947\u091c\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"],"Off. Patients can't get report login codes by text.":["\u092c\u0902\u0926\u0964 \u092e\u0930\u0940\u091c\u093c\u094b\u0902 \u0915\u094b \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0932\u0949\u0917\u093f\u0928 \u0915\u094b\u0921 SMS \u0938\u0947 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0947\u0902\u0917\u0947\u0964"],"Your SMS service gives you this address.":["\u092f\u0939 \u092a\u0924\u093e \u0906\u092a\u0915\u0940 SMS \u0938\u0947\u0935\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"],"The message is added to the address.":["\u092e\u0948\u0938\u0947\u091c \u092a\u0924\u0947 \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"],"The message is sent in the request body.":["\u092e\u0948\u0938\u0947\u091c \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u092c\u0949\u0921\u0940 \u092e\u0947\u0902 \u092d\u0947\u091c\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"],"Headers":["\u0939\u0947\u0921\u0930"],"Sent with every message, for example your API key.":["\u0939\u0930 \u092e\u0948\u0938\u0947\u091c \u0915\u0947 \u0938\u093e\u0925 \u092d\u0947\u091c\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u0948\u0938\u0947 \u0906\u092a\u0915\u0940 API \u0915\u0940\u0964"],"Leave empty to treat any OK reply as sent.":["\u0915\u093f\u0938\u0940 \u092d\u0940 OK \u091c\u0935\u093e\u092c \u0915\u094b \u092d\u0947\u091c\u093e \u0939\u0941\u0906 \u092e\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"],"The code has 6 digits.":["\u0915\u094b\u0921 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0939\u0948\u0964"],"Sent right after a booking is made.":["\u092c\u0941\u0915\u093f\u0902\u0917 \u0939\u094b\u0924\u0947 \u0939\u0940 \u092d\u0947\u091c\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"],"Clinic Staff":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0938\u094d\u091f\u093e\u092b\u093c"],"Logins for clinic managers and the front desk.":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092e\u0948\u0928\u0947\u091c\u0930 \u0914\u0930 \u0930\u093f\u0938\u0947\u092a\u094d\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u0932\u0949\u0917\u093f\u0928\u0964"],"You can already run as many clinics as you need. These add logins for clinic staff.":["\u0906\u092a \u092a\u0939\u0932\u0947 \u0938\u0947 \u091c\u093f\u0924\u0928\u0947 \u091a\u093e\u0939\u0947\u0902 \u0909\u0924\u0928\u0947 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u091a\u0932\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0947 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0938\u094d\u091f\u093e\u092b\u093c \u0915\u0947 \u0932\u093f\u090f \u0932\u0949\u0917\u093f\u0928 \u091c\u094b\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964"],"Each manager gets a dashboard for their own clinic: its doctors, bookings and details.":["\u0939\u0930 \u092e\u0948\u0928\u0947\u091c\u0930 \u0915\u094b \u0905\u092a\u0928\u0947 \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u093e \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092e\u093f\u0932\u0924\u093e \u0939\u0948: \u0909\u0938\u0915\u0947 \u0921\u0949\u0915\u094d\u091f\u0930, \u092c\u0941\u0915\u093f\u0902\u0917 \u0914\u0930 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\u0964"],"clinic dashboard page":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092a\u0947\u091c"],"A front-desk dashboard for patients, visits, test orders and lab reports.":["\u092e\u0930\u0940\u091c\u093c\u094b\u0902, \u0935\u093f\u091c\u093c\u093f\u091f, \u091f\u0947\u0938\u094d\u091f \u0911\u0930\u094d\u0921\u0930 \u0914\u0930 \u0932\u0948\u092c \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u0938\u0947\u092a\u094d\u0936\u0928 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921\u0964"],"front desk page":["\u0930\u093f\u0938\u0947\u092a\u094d\u0936\u0928 \u092a\u0947\u091c"],"days":["\u0926\u093f\u0928"],"Counted from the day the report is uploaded.":["\u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0905\u092a\u0932\u094b\u0921 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0926\u093f\u0928 \u0938\u0947 \u0917\u093f\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"],"The keys for this payment service are missing, so patients pay at the clinic for now. Add both keys below to take payment online.":["\u0907\u0938 \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0947\u0935\u093e \u0915\u0940 \u0915\u0941\u0902\u091c\u093f\u092f\u093e\u0901 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u0905\u092d\u0940 \u092e\u0930\u0940\u091c\u093c \u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u092e\u0947\u0902 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928 \u0932\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u091a\u0947 \u0926\u094b\u0928\u094b\u0902 \u0915\u0941\u0902\u091c\u093f\u092f\u093e\u0901 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"],"Doctor Pages":["\u0921\u0949\u0915\u094d\u091f\u0930 \u092a\u0947\u091c"],"Which Doctors to List":["\u0915\u094c\u0928-\u0938\u0947 \u0921\u0949\u0915\u094d\u091f\u0930 \u0926\u093f\u0916\u093e\u090f\u0901"],"Only These Doctors":["\u0938\u093f\u0930\u094d\u092b\u093c \u092f\u0947 \u0921\u0949\u0915\u094d\u091f\u0930"],"Text Messages (SMS)":["\u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092e\u0948\u0938\u0947\u091c (SMS)"],"Doctor Photos":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0940 \u092b\u093c\u094b\u091f\u094b"],"Clinic Cards":["\u0915\u094d\u0932\u093f\u0928\u093f\u0915 \u0915\u093e\u0930\u094d\u0921"],"Card Style":["\u0915\u093e\u0930\u094d\u0921 \u0938\u094d\u091f\u093e\u0907\u0932"],"Reminder Emails":["\u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0908\u092e\u0947\u0932"],"Never These Doctors":["\u092f\u0947 \u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902"],"Sort By":["\u0915\u094d\u0930\u092e"],"Border Colour":["\u092c\u0949\u0930\u094d\u0921\u0930 \u0930\u0902\u0917"],"What Cards Show":["\u0915\u093e\u0930\u094d\u0921 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0926\u093f\u0916\u0947"],"Card Background":["\u0915\u093e\u0930\u094d\u0921 \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921"],"Remind the Doctor":["\u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u094b \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u090f\u0901"],"Department Pages":["\u0935\u093f\u092d\u093e\u0917 \u092a\u0947\u091c"],"Booking Form":["\u092c\u0941\u0915\u093f\u0902\u0917 \u092b\u093c\u0949\u0930\u094d\u092e"],"What Each Doctor Card Shows":["\u0939\u0930 \u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u093e\u0930\u094d\u0921 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0926\u093f\u0916\u0947"],"Doctors per Page":["\u092a\u094d\u0930\u0924\u093f \u092a\u0947\u091c \u0921\u0949\u0915\u094d\u091f\u0930"],"Request Template":["\u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\
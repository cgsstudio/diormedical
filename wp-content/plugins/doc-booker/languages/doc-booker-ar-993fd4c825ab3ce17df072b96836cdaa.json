1\u0646 \"\u0631\u0645\u0632 \u0645\u062e\u062a\u0635\u0631\" \u0648\u0627\u0644\u0635\u0642\u0647 \u0641\u064a\u0647."],"Pages":["\u0627\u0644\u0635\u0641\u062d\u0627\u062a"],"Which pages show your lists and dashboards.":["\u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0636 \u0642\u0648\u0627\u0626\u0645\u0643 \u0648\u0644\u0648\u062d\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645."],"Lists":["\u0627\u0644\u0642\u0648\u0627\u0626\u0645"],"Which page shows each list. Pick from pages you already have.":["\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0636 \u0643\u0644 \u0642\u0627\u0626\u0645\u0629. \u0627\u062e\u062a\u0631 \u0645\u0646 \u0635\u0641\u062d\u0627\u062a\u0643 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629."],"The page that lists all doctors.":["\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0636 \u0643\u0644 \u0627\u0644\u0623\u0637\u0628\u0627\u0621."],"The page that lists all clinics.":["\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0636 \u0643\u0644 \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a."],"Front-end pages for clinic staff, and for patients to see their lab reports.":["\u0635\u0641\u062d\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0648\u0642\u0639 \u0644\u0637\u0627\u0642\u0645 \u0627\u0644\u0639\u064a\u0627\u062f\u0629\u060c \u0648\u0644\u0644\u0645\u0631\u0636\u0649 \u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0645\u062e\u062a\u0628\u0631."],"Clinic managers go here after they log in.":["\u064a\u0646\u062a\u0642\u0644 \u0645\u062f\u064a\u0631\u0648 \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a \u0625\u0644\u0649 \u0647\u0646\u0627 \u0628\u0639\u062f \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644."],"Used once clinic manager accounts are on (Settings \u2192 Clinic Staff).":["\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u062d\u0633\u0627\u0628\u0627\u062a \u0645\u062f\u064a\u0631\u064a \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a (\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u2192 \u0637\u0627\u0642\u0645 \u0627\u0644\u0639\u064a\u0627\u062f\u0629)."],"Receptionists go here after they log in.":["\u064a\u0646\u062a\u0642\u0644 \u0645\u0648\u0638\u0641\u0648 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0625\u0644\u0649 \u0647\u0646\u0627 \u0628\u0639\u062f \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644."],"Used once receptionist accounts are on (Settings \u2192 Clinic Staff).":["\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 (\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u2192 \u0637\u0627\u0642\u0645 \u0627\u0644\u0639\u064a\u0627\u062f\u0629)."],"Patients enter their mobile number and invoice code here to see their reports.":["\u064a\u064f\u062f\u062e\u0644 \u0627\u0644\u0645\u0631\u0636\u0649 \u0647\u0646\u0627 \u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644 \u0648\u0631\u0645\u0632 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0644\u0631\u0624\u064a\u0629 \u062a\u0642\u0627\u0631\u064a\u0631\u0647\u0645."],"Web Addresses":["\u0639\u0646\u0627\u0648\u064a\u0646 \u0627\u0644\u0648\u064a\u0628"],"The links to doctor, department and clinic pages.":["\u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0625\u0644\u0649 \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0627\u0644\u062a\u062e\u0635\u0635\u0627\u062a \u0648\u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a."],"The word in the link before each doctor, department or clinic name.":["\u0627\u0644\u0643\u0644\u0645\u0629 \u0641\u064a \u0627\u0644\u0631\u0627\u0628\u0637 \u0642\u0628\u0644 \u0627\u0633\u0645 \u0643\u0644 \u0637\u0628\u064a\u0628 \u0623\u0648 \u062a\u062e\u0635\u0635 \u0623\u0648 \u0639\u064a\u0627\u062f\u0629."],"Changing a word breaks links people have saved or shared. Change it before the site goes live.":["\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0643\u0644\u0645\u0629 \u064a\u064f\u0639\u0637\u0651\u0644 \u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u062a\u064a \u062d\u0641\u0638\u0647\u0627 \u0627\u0644\u0646\u0627\u0633 \u0623\u0648 \u0634\u0627\u0631\u0643\u0648\u0647\u0627. \u063a\u064a\u0651\u0631\u0647\u0627 \u0642\u0628\u0644 \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0645\u0648\u0642\u0639."],"How doctors are listed and what their pages show.":["\u0637\u0631\u064a\u0642\u0629 \u0639\u0631\u0636 \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0645\u0627 \u062a\u0639\u0631\u0636\u0647 \u0635\u0641\u062d\u0627\u062a\u0647\u0645."],"How the page with all doctors looks.":["\u0634\u0643\u0644 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0636 \u0643\u0644 \u0627\u0644\u0623\u0637\u0628\u0627\u0621."],"Turn parts of the card on or off.":["\u0634\u063a\u0651\u0644 \u0623\u062c\u0632\u0627\u0621 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0623\u0648 \u0623\u0648\u0642\u0641\u0647\u0627."],"The first lines of the doctor's bio.":["\u0627\u0644\u0633\u0637\u0648\u0631 \u0627\u0644\u0623\u0648\u0644\u0649 \u0645\u0646 \u0646\u0628\u0630\u0629 \u0627\u0644\u0637\u0628\u064a\u0628."],"For example Cardiology.":["\u0645\u062b\u0644\u064b\u0627: \u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0642\u0644\u0628."],"For example Senior Consultant.":["\u0645\u062b\u0644\u064b\u0627: \u0627\u0633\u062a\u0634\u0627\u0631\u064a \u0623\u0648\u0644."],"What the doctor treats most.":["\u0623\u0643\u062b\u0631 \u0645\u0627 \u064a\u0639\u0627\u0644\u062c\u0647 \u0627\u0644\u0637\u0628\u064a\u0628."],"Workplace":["\u0645\u0643\u0627\u0646 \u0627\u0644\u0639\u0645\u0644"],"Hospital or practice name.":["\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u0649 \u0623\u0648 \u0627\u0644\u0639\u064a\u0627\u062f\u0629."],"Degrees":["\u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a"],"For example MBBS, FCPS.":["\u0645\u062b\u0644\u064b\u0627: MBBS\u060c FCPS."],"Icons for the doctor's profiles.":["\u0623\u064a\u0642\u0648\u0646\u0627\u062a \u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0628."],"Photos":["\u0627\u0644\u0635\u0648\u0631"],"Size of the photo on each card.":["\u062d\u062c\u0645 \u0627\u0644\u0635\u0648\u0631\u0629 \u0641\u064a \u0643\u0644 \u0628\u0637\u0627\u0642\u0629."],"Width (px)":["\u0627\u0644\u0639\u0631\u0636 (px)"],"Height (px)":["\u0627\u0644\u0627\u0631\u062a\u0641\u0627\u0639 (px)"],"Off keeps the whole photo and may leave the cards different heights.":["\u0639\u0646\u062f \u0627\u0644\u0625\u064a\u0642\u0627\u0641 \u062a\u0628\u0642\u0649 \u0627\u0644\u0635\u0648\u0631\u0629 \u0643\u0627\u0645\u0644\u0629 \u0648\u0642\u062f \u062a\u062e\u062a\u0644\u0641 \u0627\u0631\u062a\u0641\u0627\u0639\u0627\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a."],"None \u2013 e.g. 12px or 0 15px 15px 15px":["\u0628\u0644\u0627 \u2013 \u0645\u062b\u0627\u0644: 12px \u0623\u0648 0 15px 15px 15px"],"One value for all corners, or four: top-left, top-right, bottom-right, bottom-left.":["\u0642\u064a\u0645\u0629 \u0648\u0627\u062d\u062f\u0629 \u0644\u0643\u0644 \u0627\u0644\u0632\u0648\u0627\u064a\u0627\u060c \u0623\u0648 \u0623\u0631\u0628\u0639: \u0623\u0639\u0644\u0649 \u0627\u0644\u064a\u0633\u0627\u0631\u060c \u0623\u0639\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646\u060c \u0623\u0633\u0641\u0644 \u0627\u0644\u064a\u0645\u064a\u0646\u060c \u0623\u0633\u0641\u0644 \u0627\u0644\u064a\u0633\u0627\u0631."],"Leave these empty to list every doctor.":["\u0627\u062a\u0631\u0643\u0647\u0627 \u0641\u0627\u0631\u063a\u0629 \u0644\u0639\u0631\u0636 \u0643\u0644 \u0627\u0644\u0623\u0637\u0628\u0627\u0621."],"Add a doctor\u2026":["\u0625\u0636\u0627\u0641\u0629 \u0637\u0628\u064a\u0628\u2026"],"Add a department\u2026":["\u0625\u0636\u0627\u0641\u0629 \u062a\u062e\u0635\u0635\u2026"],"Days, times and clinics on the doctor's page.":["\u0627\u0644\u0623\u064a\u0627\u0645 \u0648\u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0648\u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0637\u0628\u064a\u0628."],"Adds \"Bookable\" next to times patients can book online.":["\u064a\u0636\u064a\u0641 \"\u0645\u062a\u0627\u062d \u0644\u0644\u062d\u062c\u0632\" \u0628\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u062d\u062c\u0632\u0647\u0627 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a."],"The clinic's phone number beside the schedule.":["\u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0627\u0644\u0639\u064a\u0627\u062f\u0629 \u0628\u062c\u0627\u0646\u0628 \u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u0639\u0645\u0644."],"How clinics are listed and what their pages show.":["\u0637\u0631\u064a\u0642\u0629 \u0639\u0631\u0636 \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a \u0648\u0645\u0627 \u062a\u0639\u0631\u0636\u0647 \u0635\u0641\u062d\u0627\u062a\u0647\u0627."],"How the page with all clinics looks.":["\u0634\u0643\u0644 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0636 \u0643\u0644 \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a."],"The first lines about the clinic.":["\u0627\u0644\u0633\u0637\u0648\u0631 \u0627\u0644\u0623\u0648\u0644\u0649 \u0639\u0646 \u0627\u0644\u0639\u064a\u0627\u062f\u0629."],"Opens the clinic's location on a map.":["\u064a\u0641\u062a\u062d \u0645\u0648\u0642\u0639 \u0627\u0644\u0639\u064a\u0627\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629."],"View Location Map":["\u0639\u0631\u0636 \u0627\u0644\u0645\u0648\u0642\u0639 \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629"],"Clinic photos":["\u0635\u0648\u0631 \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a"],"Leave these empty to list every clinic.":["\u0627\u062a\u0631\u0643\u0647\u0627 \u0641\u0627\u0631\u063a\u0629 \u0644\u0639\u0631\u0636 \u0643\u0644 \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a."],"Add a clinic\u2026":["\u0625\u0636\u0627\u0641\u0629 \u0639\u064a\u0627\u062f\u0629\u2026"],"Slider":["\u0634\u0631\u064a\u0637 \u062a\u0645\u0631\u064a\u0631"],"Grid":["\u0634\u0628\u0643\u0629"],"Booking Rules":["\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062d\u062c\u0632"],"Booking limits, reminder emails and cancelling.":["\u062d\u062f\u0648\u062f \u0627\u0644\u062d\u062c\u0632 \u0648\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0630\u0643\u064a\u0631 \u0648\u0627\u0644\u0625\u0644\u063a\u0627\u0621."],"days ahead":["\u064a\u0648\u0645\u064b\u0627 \u0645\u0642\u062f\u0645\u064b\u0627"],"0 means no limit. The calendar only shows days up to this.":["0 \u064a\u0639\u0646\u064a \u0628\u0644\u0627 \u062d\u062f. \u064a\u0639\u0631\u0636 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0623\u064a\u0627\u0645 \u062d\u062a\u0649 \u0647\u0630\u0627 \u0627\u0644\u062d\u062f \u0641\u0642\u0637."],"hours":["\u0633\u0627\u0639\u0627\u062a"],"With 2, at 10:15 the earliest time a patient can pick is 12:15. 0 allows any time that has not passed.":["\u0645\u0639 \u0627\u0644\u0642\u064a\u0645\u0629 2\u060c \u0639\u0646\u062f 10:15 \u064a\u0643\u0648\u0646 \u0623\u0642\u0631\u0628 \u0648\u0642\u062a \u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0631\u064a\u0636 \u0627\u062e\u062a\u064a\u0627\u0631\u0647 12:15. \u0627\u0644\u0642\u064a\u0645\u0629 0 \u062a\u0633\u0645\u062d \u0628\u0623\u064a \u0648\u0642\u062a \u0644\u0645 \u064a\u0645\u0636\u0650."],"Sent about a day before the appointment.":["\u062a\u064f\u0631\u0633\u0644 \u0642\u0628\u0644 \u0627\u0644\u0645\u0648\u0639\u062f \u0628\u064a\u0648\u0645 \u062a\u0642\u0631\u064a\u0628\u064b\u0627."],"With the clinic address and a link to cancel. Not sent for bookings made less than a day ahead.":["\u0645\u0639 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0639\u064a\u0627\u062f\u0629 \u0648\u0631\u0627\u0628\u0637 \u0644\u0644\u0625\u0644\u063a\u0627\u0621. \u0644\u0627 \u062a\u064f\u0631\u0633\u0644 \u0644\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062a\u0645 \u0642\u0628\u0644 \u0627\u0644\u0645\u0648\u0639\u062f \u0628\u0623\u0642\u0644 \u0645\u0646 \u064a\u0648\u0645."],"With the patient's name and phone, to the email on the doctor's profile.":["\u0645\u0639 \u0627\u0633\u0645 \u0627\u0644\u0645\u0631\u064a\u0636 \u0648\u0647\u0627\u062a\u0641\u0647\u060c \u0625\u0644\u0649 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0641\u064a \u0645\u0644\u0641 \u0627\u0644\u0637\u0628\u064a\u0628."],"Cancelling":["\u062c\u0627\u0631\u064d \u0627\u0644\u0625\u0644\u063a\u0627\u0621"],"The time then opens up for other patients. Bookings paid online can only be cancelled by the clinic.":["\u064a\u0635\u0628\u062d \u0627\u0644\u0648\u0642\u062a \u0628\u0639\u062f\u0647\u0627 \u0645\u062a\u0627\u062d\u064b\u0627 \u0644\u0645\u0631\u0636\u0649 \u0622\u062e\u0631\u064a\u0646. \u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0644\u0627 \u062a\u0644\u063a\u064a\u0647\u0627 \u0625\u0644\u0627 \u0627\u0644\u0639\u064a\u0627\u062f\u0629."],"hours before":["\u0633\u0627\u0639\u0627\u062a \u0642\u0628\u0644"],"After this, the link tells the patient to call the clinic. 0 allows cancelling until the appointment starts.":["\u0628\u0639\u062f \u0630\u0644\u0643\u060c \u064a\u0637\u0644\u0628 \u0627\u0644\u0631\u0627\u0628\u0637 \u0645\u0646 \u0627\u0644\u0645\u0631\u064a\u0636 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0639\u064a\u0627\u062f\u0629. \u0627\u0644\u0642\u064a\u0645\u0629 0 \u062a\u0633\u0645\u062d \u0628\u0627\u0644\u0625\u0644\u063a\u0627\u0621 \u062d\u062a\u0649 \u0628\u062f\u0621 \u0627\u0644\u0645\u0648\u0639\u062f."],"Style":["\u0627\u0644\u0646\u0645\u0637"],"Colours and text on doctor and clinic cards.":["\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0648\u0627\u0644\u0646\u0635\u0648\u0635 \u0641\u064a \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a."],"Colours":["\u0627\u0644\u0623\u0644\u0648\u0627\u0646"],"Used across doctor and clinic pages, buttons and the booking form.":["\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0623\u0637\u0628\u0627\u0621 \u0648\u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a \u0648\u0627\u0644\u0623\u0632\u0631\u0627\u0631 \u0648\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062d\u062c\u0632."],"Buttons, links and highlights.":["\u0627\u0644\u0623\u0632\u0631\u0627\u0631 \u0648\u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0648\u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u0645\u064a\u0632\u0629."],"Soft backgrounds and tags.":["\u062e\u0644\u0641\u064a\u0627\u062a \u0648\u0648\u0633\u0648\u0645 \u0647\u0627\u062f\u0626\u0629."],"Lines around cards and boxes.":["\u062d\u062f\u0648\u062f \u062d\u0648\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0648\u0627\u0644\u0645\u0631\u0628\u0639\u0627\u062a."],"Name":["\u0627\u0644\u0627\u0633\u0645"],"Payments":["\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a"],"Take payment by card when patients book.":["\u062a\u0644\u0642\u064e\u0651 \u0627\u0644\u062f\u0641\u0639 \u0628\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0639\u0646\u062f \u062d\u062c\u0632 \u0627\u0644\u0645\u0631\u0636\u0649."],"Patients pay when they book.":["\u064a\u062f\u0641\u0639 \u0627\u0644\u0645\u0631\u0636\u0649 \u0639\u0646\u062f \u0627\u0644\u062d\u062c\u0632."],"Patients pay by card when they book.":["\u064a\u062f\u0641\u0639 \u0627\u0644\u0645\u0631\u0636\u0649 \u0628\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0639\u0646\u062f \u0627\u0644\u062d\u062c\u0632."],"Mode":["\u0627\u0644\u0648\u0636\u0639"],"Patients choose: pay online now, or pay at the clinic on the day. When off, they must pay online.":["\u064a\u062e\u062a\u0627\u0631 \u0627\u0644\u0645\u0631\u0636\u0649: \u0627\u0644\u062f\u0641\u0639 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0627\u0644\u0622\u0646\u060c \u0623\u0648 \u0641\u064a \u0627\u0644\u0639\u064a\u0627\u062f\u0629 \u064a\u0648\u0645 \u0627\u0644\u0645\u0648\u0639\u062f. \u0639\u0646\u062f \u0627\u0644\u0625\u064a\u0642\u0627\u0641\u060c \u064a\u062c\u0628 \u0627\u0644\u062f\u0641\u0639 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a."],"SMS & OTP":["SMS \u0648\u0631\u0645\u0632 \u0627\u0644\u062a\u062d\u0642\u0642"],"Text message login codes and booking confirmations.":["\u0631\u0645\u0648\u0632 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u062a\u0623\u0643\u064a\u062f\u0627\u062a \u0627\u0644\u062d\u062c\u0632 \u0628\u0631\u0633\u0627\u0626\u0644 \u0646\u0635\u064a\u0629."],"Sends login codes for the lab reports page and booking confirmations by text.":["\u064a\u0631\u0633\u0644 \u0631\u0645\u0648\u0632 \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0635\u0641\u062d\u0629 \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0645\u062e\u062a\u0628\u0631 \u0648\u062a\u0623\u0643\u064a\u062f\u0627\u062a \u0627\u0644\u062d\u062c\u0632 \u0628\u0631\u0633\u0627\u0626\u0644 \u0646\u0635\u064a\u0629."],"On. Codes and confirmations go out through the service below.":["\u0645\u0641\u0639\u0651\u0644. \u062a\u064f\u0631\u0633\u0644 \u0627\u0644\u0631\u0645\u0648\u0632 \u0648\u0627\u0644\u062a\u0623\u0643\u064a\u062f\u0627\u062a \u0639\u0628\u0631 \u0627\u0644\u062e\u062f\u0645\u0629 \u0623\u062f\u0646\u0627\u0647."],"Off. Patients can't get report login codes by text.":["\u0645\u0639\u0637\u0651\u0644. \u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0631\u0636\u0649 \u062a\u0644\u0642\u064a \u0631\u0645\u0648\u0632 \u062f\u062e\u0648\u0644 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0628\u0631\u0633\u0627\u0644\u0629 \u0646\u0635\u064a\u0629."],"Your SMS service gives you this address.":["\u062a\u0632\u0648\u0651\u062f\u0643 \u062e\u062f\u0645\u0629 SMS \u0628\u0647\u0630\u0627 \u0627\u0644\u0639\u0646\u0648\u0627\u0646."],"The message is added to the address.":["\u062a\u064f\u0636\u0627\u0641 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0625\u0644\u0649 \u0627\u0644\u0639\u0646\u0648\u0627\u0646."],"The message is sent in the request body.":["\u062a\u064f\u0631\u0633\u0644 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0641\u064a \u0645\u062a\u0646 \u0627\u0644\u0637\u0644\u0628."],"Headers":["\u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646"],"Sent with every message, for example your API key.":["\u064a\u064f\u0631\u0633\u0644 \u0645\u0639 \u0643\u0644 \u0631\u0633\u0627\u0644\u0629\u060c \u0645\u062b\u0644 \u0645\u0641\u062a\u0627\u062d API."],"Leave empty to treat any OK reply as sent.":["\u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0627\u0639\u062a\u0628\u0627\u0631 \u0623\u064a \u0631\u062f \u0646\u0627\u062c\u062d \u0645\u064f\u0631\u0633\u0644\u064b\u0627."],"The code has 6 digits.":["\u064a\u062a\u0643\u0648\u0646 \u0627\u0644\u0631\u0645\u0632 \u0645\u0646 6 \u0623\u0631\u0642\u0627\u0645."],"Sent right after a booking is made.":["\u062a\u064f\u0631\u0633\u0644 \u0641\u0648\u0631 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u062d\u062c\u0632."],"Clinic Staff":["\u0637\u0627\u0642\u0645 \u0627\u0644\u0639\u064a\u0627\u062f\u0629"],"Logins for clinic managers and the front desk.":["\u062d\u0633\u0627\u0628\u0627\u062a \u062f\u062e\u0648\u0644 \u0644\u0645\u062f\u064a\u0631\u064a \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a \u0648\u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644."],"You can already run as many clinics as you need. These add logins for clinic staff.":["\u064a\u0645\u0643\u0646\u0643 \u0628\u0627\u0644\u0641\u0639\u0644 \u0625\u062f\u0627\u0631\u0629 \u0623\u064a \u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u062a\u0636\u064a\u0641 \u062d\u0633\u0627\u0628\u0627\u062a \u062f\u062e\u0648\u0644 \u0644\u0637\u0627\u0642\u0645 \u0627\u0644\u0639\u064a\u0627\u062f\u0629."],"Each manager gets a dashboard for their own clinic: its doctors, bookings and details.":["\u064a\u062d\u0635\u0644 \u0643\u0644 \u0645\u062f\u064a\u0631 \u0639\u0644\u0649 \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 \u0644\u0639\u064a\u0627\u062f\u062a\u0647: \u0623\u0637\u0628\u0627\u0624\u0647\u0627 \u0648\u062d\u062c\u0648\u0632\u0627\u062a\u0647\u0627 \u0648\u062a\u0641\u0627\u0635\u064a\u0644\u0647\u0627."],"clinic dashboard page":["\u0635\u0641\u062d\u0629 \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 \u0627\u0644\u0639\u064a\u0627\u062f\u0629"],"A front-desk dashboard for patients, visits, test orders and lab reports.":["\u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 \u0644\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u062a\u0634\u0645\u0644 \u0627\u0644\u0645\u0631\u0636\u0649 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0627\u062a \u0648\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u062d\u0627\u0644\u064a\u0644 \u0648\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0645\u062e\u062a\u0628\u0631."],"front desk page":["\u0635\u0641\u062d\u0629 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644"],"days":["\u0623\u064a\u0627\u0645"],"Counted from the day the report is uploaded.":["\u062a\u064f\u062d\u0633\u0628 \u0645\u0646 \u064a\u0648\u0645 \u0631\u0641\u0639 \u0627\u0644\u062a\u0642\u0631\u064a\u0631."],"The keys for this payment service are missing, so patients pay at the clinic for now. Add both keys below to take payment online.":["\u0645\u0641\u0627\u062a\u064a\u062d \u062e\u062f\u0645\u0629 \u0627\u0644\u0
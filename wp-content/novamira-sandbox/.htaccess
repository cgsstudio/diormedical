# Novamira sandbox: only CSS, JavaScript and the empty directory index may be served directly.
<FilesMatch "(?i)(^(?!index[.]html$|.*[.](?:css|js)$).+$|[.](?:php[0-9]?|phtml|phar)(?:[.]|$))">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
